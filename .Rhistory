df_ipj_resumo <- df_ipj_geral |>
mutate(
`Satisfeito + M. Satisfeito` = paste0(round(S_pct + MS_pct, 1), "%"),
`M. Insatisfeito + Insatisfeito` = paste0(round(MI_pct + I_pct, 1), "%")
) |>
select(
Público = Publico,
`M. Insatisfeito (%)` = MI_pct,
`Insatisfeito (%)` = I_pct,
`Satisfeito (%)` = S_pct,
`M. Satisfeito (%)` = MS_pct,
`Total positivo` = `Satisfeito + M. Satisfeito`,
`Total negativo` = `M. Insatisfeito + Insatisfeito`
) |>
mutate(across(where(is.numeric), ~paste0(.x, "%")))
ft_cnj(df_ipj_resumo,
caption = "Tabela 16 — Distribuição do IPJ por público")
