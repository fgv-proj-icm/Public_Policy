# ── Funções auxiliares ───────────────────────────────────────────────────
fmt_n <- function(x) {
format(
x,
big.mark = ".",
decimal.mark = ",",
scientific = FALSE,
trim = TRUE
)
}
fmt_1 <- function(x) {
format(
round(x, 1),
nsmall = 1,
decimal.mark = ",",
scientific = FALSE,
trim = TRUE
)
}
read_csv_utf8 <- function(path) {
if (!file.exists(path)) {
stop(paste("Arquivo não encontrado:", path))
}
readr::read_csv(
file = path,
show_col_types = FALSE,
locale = readr::locale(encoding = "UTF-8")
) |>
as.data.frame()
}
to_numeric_safe <- function(x) {
suppressWarnings(as.numeric(x))
}
# ── Paleta consistente ───────────────────────────────────────────────────
pal_nuclear <- "#2563eb"
pal_extended <- "#059669"
pal_excluded <- "#dc2626"
pal_bases <- c(
"openalex" = "#E64A19",
"semantic_scholar" = "#7B1FA2",
"crossref" = "#1565C0",
"scopus" = "#2E7D32"
)
#| label: tbl-parametros
#| tbl-cap: "Parâmetros do protocolo de busca"
tribble(
~Parâmetro, ~Especificação,
"Bases de dados", "OpenAlex, Scopus, Semantic Scholar, Crossref",
"Campos pesquisados", "Título, resumo, palavras-chave (TITLE-ABS-KEY)",
"Recorte temporal", "2000–2026",
"Tipos documentais", "Artigos de periódico e revisões (article, review)",
"Idiomas", "Inglês, português, espanhol",
"Data da coleta", "22–23 de abril de 2026",
"Repositório", "github.com/cairesmachado-svg/Public_Policy"
) |>
kable(align = "ll") |>
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
#| include: false
# ── Função auxiliar para ler CSV em UTF-8 ────────────────────────────────
read_csv_utf8 <- function(path) {
if (!file.exists(path)) {
stop(paste("Arquivo não encontrado:", path))
}
readr::read_csv(
file = path,
show_col_types = FALSE,
locale = readr::locale(encoding = "UTF-8")
) |>
as.data.frame()
}
# ── Carregar corpus congelado ────────────────────────────────────────────
corpus <- read_csv_utf8("data/final/corpus_complete.csv")
nuclear <- read_csv_utf8("data/final/corpus_nuclear.csv")
extended <- read_csv_utf8("data/final/corpus_extended.csv")
# ── Carregar dados intermediários para números PRISMA ────────────────────
merged <- read_csv_utf8("data/interim/01_merged_all_sources.csv")
deduped <- read_csv_utf8("data/interim/02_deduplicated.csv")
excluded <- read_csv_utf8("data/interim/04_excluded_update.csv")
# ── Ajustes de tipo ──────────────────────────────────────────────────────
to_numeric_safe <- function(x) suppressWarnings(as.numeric(x))
if ("publication_year" %in% names(corpus)) {
corpus$publication_year <- to_numeric_safe(corpus$publication_year)
}
if ("cited_by_count" %in% names(corpus)) {
corpus$cited_by_count <- to_numeric_safe(corpus$cited_by_count)
}
if ("publication_year" %in% names(nuclear)) {
nuclear$publication_year <- to_numeric_safe(nuclear$publication_year)
}
if ("cited_by_count" %in% names(nuclear)) {
nuclear$cited_by_count <- to_numeric_safe(nuclear$cited_by_count)
}
if ("publication_year" %in% names(extended)) {
extended$publication_year <- to_numeric_safe(extended$publication_year)
}
if ("cited_by_count" %in% names(extended)) {
extended$cited_by_count <- to_numeric_safe(extended$cited_by_count)
}
# ── Números PRISMA ───────────────────────────────────────────────────────
n_identified <- nrow(merged)
n_deduplicated <- nrow(deduped)
n_duplicates <- n_identified - n_deduplicated
n_excluded <- nrow(excluded)
n_included <- nrow(corpus)
n_nuclear <- nrow(nuclear)
n_extended <- nrow(extended)
# ── Checagem rápida de consistência ──────────────────────────────────────
if ((n_nuclear + n_extended) != n_included) {
warning(
paste0(
"Atenção: nuclear + extended = ", n_nuclear + n_extended,
" e corpus completo = ", n_included,
". Verifique os arquivos exportados."
)
)
}
#| label: fig-prisma-flow
#| fig-cap: "Diagrama PRISMA-flow adaptado para análise bibliométrica"
#| fig-width: 8
#| fig-height: 10
fmt_n <- function(x) {
format(x, big.mark = ".", decimal.mark = ",", scientific = FALSE, trim = TRUE)
}
# Diagrama PRISMA usando ggplot
prisma_data <- tibble(
stage = c("Identificação", "Deduplicação", "Triagem", "Excluídos",
"Anel Nuclear", "Anel Estendido", "Total Incluído"),
n = c(n_identified, n_duplicates, n_deduplicated, n_excluded,
n_nuclear, n_extended, n_included),
x = c(0, 0, 0, 1.5, -0.8, 0.8, 0),
y = c(6, 5, 4, 3, 1.5, 1.5, 0.5),
color = c("grey60", "grey40", "grey60", pal_excluded,
pal_nuclear, pal_extended, "grey20"),
label = c(
paste0("Registros identificados\n(4 bases)\nn = ", fmt_n(n_identified)),
paste0("Duplicatas removidas\nn = ", fmt_n(n_duplicates)),
paste0("Registros triados\nn = ", fmt_n(n_deduplicated)),
paste0("Excluídos\nn = ", fmt_n(n_excluded)),
paste0("Anel Nuclear\n\"política judiciária\"\nn = ", fmt_n(n_nuclear)),
paste0("Anel Estendido\ntermos cognatos\nn = ", fmt_n(n_extended)),
paste0("Total incluído\nn = ", fmt_n(n_included))
)
)
ggplot(prisma_data, aes(x, y)) +
geom_label(aes(label = label, fill = color), size = 3.5,
color = "white", fontface = "bold",
label.padding = unit(0.6, "lines"),
label.r = unit(0.3, "lines")) +
geom_segment(aes(x = 0, xend = 0, y = 5.7, yend = 5.3),
arrow = arrow(length = unit(0.2, "cm")), color = "grey50") +
geom_segment(aes(x = 0, xend = 0, y = 4.7, yend = 4.3),
arrow = arrow(length = unit(0.2, "cm")), color = "grey50") +
geom_segment(aes(x = 0.3, xend = 1.2, y = 3.5, yend = 3.2),
arrow = arrow(length = unit(0.2, "cm")), color = pal_excluded) +
geom_segment(aes(x = -0.2, xend = -0.7, y = 3.5, yend = 2),
arrow = arrow(length = unit(0.2, "cm")), color = pal_nuclear) +
geom_segment(aes(x = 0.2, xend = 0.7, y = 3.5, yend = 2),
arrow = arrow(length = unit(0.2, "cm")), color = pal_extended) +
geom_segment(aes(x = -0.6, xend = -0.2, y = 1.1, yend = 0.8),
arrow = arrow(length = unit(0.2, "cm")), color = "grey50") +
geom_segment(aes(x = 0.6, xend = 0.2, y = 1.1, yend = 0.8),
arrow = arrow(length = unit(0.2, "cm")), color = "grey50") +
scale_fill_identity() +
xlim(-2, 2.5) + ylim(0, 6.5) +
theme_void() +
labs(title = "PRISMA Flow Diagram",
subtitle = "Adaptado para análise bibliométrica com dois anéis concêntricos")
#| label: tbl-exclusion
#| tbl-cap: "Motivos de exclusão na triagem"
excluded |>
count(exclusion_reason, sort = TRUE) |>
mutate(
pct = percent(n / sum(n), accuracy = 0.1),
motivo = case_when(
exclusion_reason == "sem_relacao_sistema_justica" ~ "Sem relação com o sistema de justiça",
exclusion_reason == "judicial_review_constitucionalista" ~ "Judicial review (constitucionalista)",
exclusion_reason == "periódico_ou_título_fora_escopo" ~ "Periódico ou título fora do escopo",
exclusion_reason == "judicializacao_politicas" ~ "Judicialização de políticas públicas",
exclusion_reason == "tema_fora_escopo" ~ "Tema fora do escopo",
exclusion_reason == "metadados_insuficientes" ~ "Metadados insuficientes",
TRUE ~ exclusion_reason
)
) |>
select(Motivo = motivo, N = n, `%` = pct) |>
kable(align = "lrc") |>
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
#| label: tbl-overview
#| tbl-cap: "Visão geral do corpus"
fmt_n <- function(x) {
format(x, big.mark = ".", decimal.mark = ",", scientific = FALSE, trim = TRUE)
}
fmt_1 <- function(x) {
format(round(x, 1), nsmall = 1, decimal.mark = ",", scientific = FALSE, trim = TRUE)
}
tibble(
Indicador = c(
"Total de registros",
"Anel nuclear",
"Anel estendido",
"Período coberto",
"Periódicos distintos",
"Total de citações",
"Média de citações por artigo",
"Mediana de citações"
),
`Corpus completo` = c(
fmt_n(n_included),
fmt_n(n_nuclear),
fmt_n(n_extended),
paste0(min(corpus$publication_year, na.rm = TRUE), "–",
max(corpus$publication_year, na.rm = TRUE)),
fmt_n(dplyr::n_distinct(corpus$journal[!is.na(corpus$journal) & corpus$journal != ""])),
fmt_n(sum(corpus$cited_by_count, na.rm = TRUE)),
fmt_1(mean(corpus$cited_by_count, na.rm = TRUE)),
fmt_n(median(corpus$cited_by_count, na.rm = TRUE))
),
`Anel nuclear` = c(
fmt_n(n_nuclear),
"—",
"—",
paste0(min(nuclear$publication_year, na.rm = TRUE), "–",
max(nuclear$publication_year, na.rm = TRUE)),
fmt_n(dplyr::n_distinct(nuclear$journal[!is.na(nuclear$journal) & nuclear$journal != ""])),
fmt_n(sum(nuclear$cited_by_count, na.rm = TRUE)),
fmt_1(mean(nuclear$cited_by_count, na.rm = TRUE)),
fmt_n(median(nuclear$cited_by_count, na.rm = TRUE))
)
) |>
kable(align = "lcc") |>
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
#| label: fig-temporal
#| fig-cap: "Evolução temporal da produção científica por anel"
#| fig-height: 5
# Produção anual por anel
yearly <- corpus |>
filter(!is.na(publication_year), publication_year >= 2000, publication_year <= 2025) |>
count(publication_year, ring) |>
complete(publication_year = 2000:2025, ring = c("nuclear", "extended"), fill = list(n = 0))
p1 <- ggplot(yearly, aes(publication_year, n, fill = ring)) +
geom_col(position = "stack", alpha = 0.85) +
scale_fill_manual(
values = c("nuclear" = pal_nuclear, "extended" = pal_extended),
labels = c("nuclear" = "Anel Nuclear", "extended" = "Anel Estendido")
) +
scale_x_continuous(breaks = seq(2000, 2025, 5)) +
labs(
x = "Ano de publicação",
y = "Número de publicações",
fill = "",
title = "Produção anual — corpus completo"
)
# Nuclear isolado
yearly_nuclear <- nuclear |>
filter(!is.na(publication_year), publication_year >= 2000, publication_year <= 2025) |>
count(publication_year) |>
complete(publication_year = 2000:2025, fill = list(n = 0))
p2 <- ggplot(yearly_nuclear, aes(publication_year, n)) +
geom_col(fill = pal_nuclear, alpha = 0.85) +
geom_smooth(method = "loess", se = FALSE, color = "grey30", linewidth = 0.8) +
scale_x_continuous(breaks = seq(2000, 2025, 5)) +
labs(
x = "Ano de publicação",
y = "Número de publicações",
title = "Produção anual — anel nuclear"
)
p1 / p2
#| label: fig-sources
#| fig-cap: "Contribuição de cada base de dados ao corpus"
#| fig-height: 4
corpus |>
count(source, ring) |>
ggplot(aes(reorder(source, -n), n, fill = ring)) +
geom_col(position = "dodge", alpha = 0.85) +
scale_fill_manual(
values = c("nuclear" = pal_nuclear, "extended" = pal_extended),
labels = c("nuclear" = "Nuclear", "extended" = "Estendido")
) +
labs(x = "Base de dados", y = "Registros", fill = "",
title = "Cobertura por base de dados e anel") +
theme(axis.text.x = element_text(angle = 0))
#| label: fig-language
#| fig-cap: "Distribuição linguística do anel nuclear"
#| fig-height: 4
nuclear |>
mutate(language = ifelse(is.na(language) | language == "" | language == "nan",
"Não informado", language)) |>
count(language, sort = TRUE) |>
mutate(language = fct_reorder(language, n)) |>
ggplot(aes(language, n)) +
geom_col(fill = pal_nuclear, alpha = 0.85) +
coord_flip() +
labs(x = "", y = "Registros",
title = "Distribuição linguística — anel nuclear")
#| label: fig-bradford
#| fig-cap: "Análise de dispersão de periódicos (Lei de Bradford) — anel nuclear"
#| fig-height: 5
# Ranking de periódicos por frequência
journal_freq <- nuclear |>
filter(!is.na(journal), journal != "", journal != "nan") |>
count(journal, sort = TRUE) |>
mutate(
rank = row_number(),
cum_n = cumsum(n),
cum_pct = cum_n / sum(n),
zone = case_when(
cum_pct <= 1/3 ~ "Zona 1 (núcleo)",
cum_pct <= 2/3 ~ "Zona 2 (intermediária)",
TRUE ~ "Zona 3 (periférica)"
)
)
ggplot(journal_freq, aes(rank, cum_pct, color = zone)) +
geom_point(size = 2, alpha = 0.7) +
geom_line(color = "grey50", alpha = 0.5) +
geom_hline(yintercept = c(1/3, 2/3), linetype = "dashed", color = "grey60") +
scale_y_continuous(labels = percent) +
scale_color_manual(values = c(
"Zona 1 (núcleo)" = pal_nuclear,
"Zona 2 (intermediária)" = "#f59e0b",
"Zona 3 (periférica)" = "grey60"
)) +
labs(x = "Ranking do periódico", y = "% acumulada de artigos",
color = "", title = "Lei de Bradford — anel nuclear")
#| label: tbl-bradford
#| tbl-cap: "Periódicos do anel nuclear com 2 ou mais artigos"
journal_freq |>
filter(n >= 2) |>
select(Periódico = journal, Artigos = n, `% acumulada` = cum_pct, Zona = zone) |>
mutate(`% acumulada` = percent(`% acumulada`, accuracy = 0.1)) |>
kable(align = "lccc") |>
kable_styling(bootstrap_options = c("striped", "hover"), full_width = FALSE)
