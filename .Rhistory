# ── Pacotes ──────────────────────────────────────────────────────────
pkgs <- c("readxl","dplyr","tidyr","ggplot2","forcats","stringr",
"scales","knitr","kableExtra","RColorBrewer","patchwork",
"ggridges","viridis","corrplot","tidytext","wordcloud2",
"treemapify","ggrepel")
installed <- rownames(installed.packages())
for (p in pkgs) {
if (!p %in% installed) install.packages(p, quiet = TRUE)
}
invisible(lapply(pkgs, library, character.only = TRUE))
# ── Paleta CNJ ────────────────────────────────────────────────────────
cor_publicos <- c(
"Advogados"           = "#1B6CA8",
"Cidadãos"            = "#2E9E44",
"Defensoria Pública"  = "#D4820A",
"Ministério Público"  = "#8B2FC9"
)
cor_likert_pos <- c("#D73027","#FC8D59","#D9D9D9","#91BFDB","#4575B4")
cor_sat        <- c("#1A7A4A","#5BBD83","#D9D9D9","#F4A261","#E63946")
cor_avalia     <- c("Ótimo" = "#1A7A4A","Bom" = "#5BBD83","Ruim" = "#F4A261",
"Péssimo" = "#E63946","Não sei avaliar" = "#AAAAAA")
theme_cnj <- function() {
theme_minimal(base_family = "sans") +
theme(
plot.title       = element_text(size = 13, face = "bold", color = "#1C2B3A"),
plot.subtitle    = element_text(size = 10, color = "#4A4A4A"),
axis.title       = element_text(size = 10, color = "#1C2B3A"),
axis.text        = element_text(size = 9),
legend.title     = element_text(size = 9, face = "bold"),
legend.text      = element_text(size = 9),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "#EBEBEB"),
strip.text       = element_text(face = "bold", size = 10),
plot.caption     = element_text(size = 8, color = "#666666", hjust = 0)
)
}
