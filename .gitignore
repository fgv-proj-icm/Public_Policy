# Quarto outputs
*_files/
*_cache/
.quarto/
.quarto_cache/
*.html

# Dados e outputs (não versionar)
data/raw/*
data/interim/*
data/final/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/final/.gitkeep

# Logs (mantém template)
logs/*
!logs/runlog.md
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.venv/

# Env / segredos
.env
.env.*
*.key
*.pem

# Backups/arquivos soltos
*.tgz
